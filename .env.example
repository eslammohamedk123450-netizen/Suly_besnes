# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# AI Dev Console (Ollama) — local development only
# ---------------------------------------------------------------------------
# Get a key from https://ollama.com/settings/keys, then copy this file to `.env`
# (`.env` is already ignored by git, see .gitignore).
#
# IMPORTANT: this key is read by the Vite dev server (Node) only. It is never
# inlined into the browser bundle and never reaches players.

# Required. Server-side Ollama API key.
OLLAMA_API_KEY=your_key_here

# Optional. Cloud model served by https://ollama.com.
# NOTE: `qwen2.5-coder:7b` is a *local* Ollama model and is NOT served by
# Ollama Cloud, so it cannot be used through this API. Any model listed under
# https://ollama.com/search?c=cloud works, e.g. glm-5.3-flash, kimi-k2.7-code,
# minimax-m3.1-flash, nemotron-3-nano.
OLLAMA_MODEL=glm-5.3-flash

# Optional. Override the API base (useful for a local Ollama daemon or a mock).
OLLAMA_API_BASE=https://ollama.com

# Optional. Request timeout in milliseconds.
OLLAMA_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# DO NOT use a VITE_ prefixed key for Ollama.
# ---------------------------------------------------------------------------
# Vite inlines every `VITE_*` variable into the public browser bundle, so
# `import.meta.env.VITE_OLLAMA_API_KEY` would ship your key to every player of
# the game (and into the Android APK). It would also fail at runtime: a browser
# cannot call https://ollama.com directly because that host sends no CORS
# headers.
#
# VITE_OLLAMA_API_KEY=your_key_here
