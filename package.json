{
  "name": "business-empire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm build && pnpm preview",
    "dev:hmr": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "cap:sync": "pnpm build && cap sync",
    "cap:add:android": "cap add android",
    "cap:apk:debug": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "code:issue": "node tools/issue-code.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@supabase/supabase-js": "^2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
