      :root[data-theme="light"] .eclipse-dark, html.light .eclipse-dark, [data-theme="light"] .eclipse-dark, .theme-light .eclipse-dark, body.light .eclipse-dark, .light .eclipse-dark { display: none !important; }
      :root[data-theme="light"] .eclipse-light, html.light .eclipse-light, [data-theme="light"] .eclipse-light, .theme-light .eclipse-light, body.light .eclipse-light, .light .eclipse-light { display: block !important; }
      :root[data-theme="dark"] .eclipse-dark, html.dark .eclipse-dark, [data-theme="dark"] .eclipse-dark, .theme-dark .eclipse-dark, body.dark .eclipse-dark, .dark .eclipse-dark { display: block !important; }
      :root[data-theme="dark"] .eclipse-light, html.dark .eclipse-light, [data-theme="dark"] .eclipse-light, .theme-dark .eclipse-light, body.dark .eclipse-light, .dark .eclipse-light { display: none !important; }
    </style>
  </defs>
